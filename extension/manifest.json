{
  "manifest_version": 3,
  "name": "pwhs bridge",
  "version": "1.0.0",
  "description": "Lets playwright-http-server drive this browser profile through a local, token-protected relay.",
  "permissions": ["debugger", "tabs", "storage", "alarms", "downloads"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "pwhs bridge" },
  "incognito": "spanning"
}
