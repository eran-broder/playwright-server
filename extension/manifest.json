{
  "manifest_version": 3,
  "name": "pwhs bridge",
  "version": "2.0.0",
  "description": "Lets playwright-http-server drive this browser profile through a local relay, unlocked by pair codes you mint here.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["debugger", "tabs", "storage", "alarms", "downloads", "offscreen"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "pwhs bridge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "incognito": "spanning"
}
